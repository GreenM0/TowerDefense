<Window x:Class="TowerDefense.Towers.Towerwindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turm Optionen" Height="300" Width="300"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#3E2A47" Foreground="White">

    <Grid Margin="20,20,20,11">
        <!-- Grid-Definition für Buttons -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Upgrade-Button -->
            <RowDefinition Height="20"/>
            <!-- Abstand -->
            <RowDefinition Height="Auto"/>
            <!-- Sell-Button -->
            <RowDefinition Height="20"/>
            <!-- Abstand -->
            <RowDefinition Height="Auto"/>
            <!-- Zielmodus-Auswahl -->
            <RowDefinition Height="20"/>
            <!-- Abstand -->
            <RowDefinition Height="Auto"/>
            <!-- Close-Button -->
        </Grid.RowDefinitions>

        <!-- Upgrade Button -->
        <Button Name="UpgradeButton" Content="🛡️ Upgrade"
                Click="UpgradeTower_Click"
                Background="#C5A400" Foreground="Black"
                FontSize="16" FontFamily="Georgia"
                Padding="12,6" Width="250"
                BorderBrush="#9E7B00" BorderThickness="2" Cursor="Hand"
                Grid.Row="0"/>

        <!-- Abstand zwischen Buttons -->
        <Rectangle Height="20" Grid.Row="1"/>

        <!-- Sell Button -->
        <Button Name="SellButton" Content="💰 Verkaufen"
                Click="SellTower_Click"
                Background="#B83D3D" Foreground="White"
                FontSize="16" FontFamily="Georgia"
                Padding="12,6" Width="250"
                BorderBrush="#9E1B1B" BorderThickness="2" Cursor="Hand"
                Grid.Row="2"/>

        <!-- Abstand zwischen Buttons -->
        <Rectangle Height="20" Grid.Row="3"/>

        <!-- Zielmodus-Auswahl -->
        <ComboBox Name="TargetModeComboBox" Grid.Row="4"
                  Background="#4A90E2" Foreground="Green"
                  FontSize="16" FontFamily="Georgia"
                  Padding="12,6" Width="250"
                  BorderBrush="#357ABD" BorderThickness="2"
                  SelectionChanged="TargetModeComboBox_SelectionChanged">
            <ComboBox.Resources>
                <!-- Stil für die Dropdown-Liste -->
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#4A90E2"/>
                    <!-- Hintergrundfarbe -->
                    <Setter Property="Foreground" Value="Black"/>
                    <!-- Textfarbe -->
                    <Setter Property="FontSize" Value="16"/>
                    <!-- Schriftgröße -->
                    <Setter Property="FontFamily" Value="Georgia"/>
                    <!-- Schriftart -->
                    <Setter Property="Padding" Value="12,6"/>
                    <!-- Innenabstand -->
                    <Setter Property="BorderBrush" Value="#357ABD"/>
                    <!-- Rahmenfarbe -->
                    <Setter Property="BorderThickness" Value="2"/>
                    <!-- Rahmendicke -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ComboBox.Resources>
            <ComboBoxItem Content="🎯 Nächster Gegner" Tag="CLOSE"/>
            <ComboBoxItem Content="🎯 Stärkster Gegner" Tag="STRONG"/>
            <ComboBoxItem Content="🎯 Gegner am Ziel" Tag="NEAR_END"/>
        </ComboBox>

        <!-- Abstand zwischen Buttons -->
        <Rectangle Height="20" Grid.Row="5"/>

        <!-- Close Button -->
        <Button Content="❌ Schließen"
                Click="CloseWindow_Click"
                Background="#B83D3D" Foreground="White"
                FontSize="16" FontFamily="Georgia"
                Padding="12,6" Width="250"
                BorderBrush="#9E1B1B" BorderThickness="2" Cursor="Hand"
                Grid.Row="6"/>
    </Grid>
</Window>