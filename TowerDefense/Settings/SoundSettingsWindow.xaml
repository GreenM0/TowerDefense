<Window x:Class="TowerDefense.Settings.SoundSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Settings" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF2E2E2E">
    <!-- Dunkler Hintergrund -->
    <Window.Resources>
        <!-- Schriftart -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Old English Text MT" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Button-Stil -->
        <Style x:Key="MedievalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF8B4513" />
            <!-- Brauner Hintergrund -->
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Old English Text MT" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10 5" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#FFA0522D" />
            <!-- Dunklerer Braunton für den Rand -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="OverridesDefaultStyle" Value="True" />
        </Style>

        <!-- Slider-Stil -->
        <Style x:Key="MedievalSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8B4513" />
            <!-- Brauner Fortschrittsbalken -->
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <!-- Menü-Musik-Lautstärke -->
            <TextBlock Text="Menü-Musik Lautstärke" FontSize="16" Margin="0 0 0 10" Foreground="White" />
            <Slider x:Name="MenuVolumeSlider" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="MenuVolumeSlider_ValueChanged" Style="{StaticResource MedievalSliderStyle}" />

            <!-- Ingame-Musik-Lautstärke -->
            <TextBlock Text="Ingame-Musik Lautstärke" FontSize="16" Margin="0 20 0 10" Foreground="White" />
            <Slider x:Name="IngameVolumeSlider" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="IngameVolumeSlider_ValueChanged" Style="{StaticResource MedievalSliderStyle}" />

            <!-- Schließen-Button -->
            <Button Content="Schließen" HorizontalAlignment="Center" Margin="0 20 0 0" Padding="10 5" Click="CloseButton_Click" Style="{StaticResource MedievalButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>