<UserControl x:Class="TowerDefense.GameHandler"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TowerDefense"
        mc:Ignorable="d"
        Height="1080" Width="1920" Background="White">
    <Grid x:Name="MapGrid" Background="DarkGreen">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75*"/>
            <ColumnDefinition Width="25*"/>
        </Grid.ColumnDefinitions>

        <Image Source="Maps/Assets/Hintergrund.png" Width="480" Height="1080" Grid.Column="1"/>
        <UniformGrid Name="TowerMenu" Grid.Column="2" Margin="10,0,0,0" Rows="2" Columns="2">
        </UniformGrid>

        <Canvas x:Name="GameField" Grid.Column="0" AllowDrop="True" MouseMove="GameField_MouseMove" MouseUp="GameField_MouseUp" MouseDown="GameField_MouseDown" MouseLeave="GameField_MouseLeave"></Canvas>
        <Border Width="1440" Height="50" VerticalAlignment="Top" CornerRadius="10">
            <Border.Effect>
                <!-- Schatten für mehr Tiefe -->
                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- Herz-Symbol für Leben -->
                <Label Width="105" Height="50" FontFamily="MedievalSharp" FontSize="30" Content="♥" Foreground="Red" Panel.ZIndex="5"/>
                <!-- Aktuelle Lebenspunkte -->
                <Label x:Name="health" Width="100" Height="50" FontFamily="MedievalSharp" FontSize="30" Foreground="White" Panel.ZIndex="5"/>
                <!-- Lebensänderung (wird bei Änderungen angezeigt) -->
                <Label x:Name="healthChange" Width="100" Height="50" FontFamily="MedievalSharp" FontSize="30" Foreground="Red" Panel.ZIndex="5" Visibility="Collapsed"/>
                <!-- Welle/Level-Anzeige -->
                <Label x:Name="wave" Width="200" Height="50" FontFamily="MedievalSharp" FontSize="30" Foreground="White" Panel.ZIndex="5"/>
                <!-- Dollar-Symbol für Geld -->
                <Label Width="80" Height="50" FontFamily="MedievalSharp" FontSize="30" Content="$" Foreground="Gold" Panel.ZIndex="5"/>
                <!-- Aktuelles Geld -->
                <Label x:Name="Cashbar" Width="100" Height="50" FontFamily="MedievalSharp" FontSize="30" Foreground="White" Panel.ZIndex="5"/>
                <!-- Geldänderung (wird bei Änderungen angezeigt) -->
                <Label x:Name="cashChange" Width="100" Height="50" FontFamily="MedievalSharp" FontSize="30" Foreground="Green" Panel.ZIndex="5" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Label x:Name="info"  Width="600" Height="400" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="80" Panel.ZIndex="5" Visibility="Hidden"/>
    </Grid>
</UserControl>
