<Window x:Class="TowerDefense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TowerDefense"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="Menu" Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="Start" Grid.Row="1" Grid.Column="1" Width="600" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="🎮 Spiel Starten"
                    FontFamily="Georgia" FontSize="40" Click="Start_Click"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Rectangle Height="20" Grid.Row="2" Grid.Column="1"/>

            <Button x:Name="Restart" Grid.Row="3" Grid.Column="1" Width="600" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="🔄 Neustarten"
                    FontFamily="Georgia" FontSize="40" Click="Restart_Click"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Rectangle Height="20" Grid.Row="4" Grid.Column="1"/>

            <Button x:Name="Tutorial" Grid.Row="5" Grid.Column="1" Width="600" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="📖 Spielanleitung"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource RoundedButtonStyle}" Click="Tutorial_Click"/>

            <Rectangle Height="20" Grid.Row="6" Grid.Column="1"/>

            <Button x:Name="Credits" Grid.Row="7" Grid.Column="1" Width="600" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="⭐ Credits"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource RoundedButtonStyle}" Click="Credits_Click"/>

            <Rectangle Height="20" Grid.Row="8" Grid.Column="1"/>

            <Button x:Name="Leave" Grid.Row="9" Grid.Column="1" Width="600" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="🚪 Verlassen"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource RoundedButtonStyle}" Click="Leave_Click"/>

            <!-- Pfeil nach links -->
            <Button x:Name="LeftArrow" Grid.Row="4" Grid.Column="0" Width="100" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="←"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource ArrowButtonStyle}" Click="LeftArrow_Click"
                    IsEnabled="False" Margin="280,20,280,0" Grid.RowSpan="2"/>

            <!-- Pfeil nach rechts -->
            <Button x:Name="RightArrow" Grid.Row="4" Grid.Column="2" Width="100" Height="100"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    Foreground="Black" Content="→"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource ArrowButtonStyle}" Click="RightArrow_Click"
                    IsEnabled="True" Margin="280,20,280,0" Grid.RowSpan="2"/>

            <Button x:Name="SettingsButton" Content="⚙️" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10" Click="SettingsButton_Click" Height="111" Width="100" Grid.Column="2"
                    BorderBrush="#8B5A2B" BorderThickness="3" Background="#A97D50"
                    FontFamily="Georgia" FontSize="40"
                    Cursor="Hand" Panel.ZIndex="5"
                    Style="{StaticResource ArrowButtonStyle}"
                    IsEnabled="True" Margin="0,10,101,0"/>

        </Grid>
        <MediaElement x:Name="MenuMusic" Source="..\..\..\Helper\Assets\Musik.mp3" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="MenuMusic_MediaEnded" />
    </Grid>

</Window>