<Window x:Class="TowerDefense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TowerDefense"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        WindowState="Maximized">
    <Grid x:Name="MainGrid" Background="Gray">
        <Button x:Name="Start" Width="400" Height="200" BorderBrush="Black" BorderThickness="3" Background="DarkGreen" Content="Spiel Starten" FontFamily="Arial" FontSize="40" Click="Start_Click"/>
    </Grid>
</Window>
